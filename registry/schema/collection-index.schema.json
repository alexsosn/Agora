{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexsosn/Agora/registry/schema/collection-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collection_id", "index_status", "members"],
  "properties": {
    "schema_version": {"const": 1},
    "collection_id": {"type": "string"},
    "index_status": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "languages", "verification"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "author": {"type": "string"},
          "title": {"type": "string"},
          "canonical_id": {"type": "string"},
          "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "tf_path": {"type": "string"},
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {"type": "string"},
              "notes": {"type": "array", "items": {"type": "string"}}
            }
          },
          "known_issues": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
