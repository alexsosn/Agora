{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexsosn/Agora/registry/schema/collection-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collection_id", "index_status", "members"],
  "properties": {
    "schema_version": {"const": 1},
    "collection_id": {"type": "string"},
    "source_revision": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      ]
    },
    "index_status": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "tf_path", "languages", "verification"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "tf_path": {"type": "string", "minLength": 1},
          "author": {"type": "string"},
          "title": {"type": "string"},
          "canonical_id": {"type": "string"},
          "edition": {"type": "string"},
          "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {"type": "string"},
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["check_id"],
                  "properties": {
                    "check_id": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
                    }
                  }
                }
              },
              "known_issues": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["issue_id"],
                  "properties": {
                    "issue_id": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
                    }
                  }
                }
              },
              "notes": {"type": "array", "items": {"type": "string"}}
            }
          },
          "integration_issues": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"index_status": {"const": "complete"}},
        "required": ["index_status"]
      },
      "then": {
        "required": ["source_revision"],
        "properties": {"members": {"minItems": 1}}
      }
    }
  ]
}
