{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexsosn/Agora/registry/schema/release-scope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "required_plugins", "required_resources"],
  "properties": {
    "schema_version": {"const": 1},
    "release": {"type": "string", "minLength": 1},
    "required_plugins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "required_resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
