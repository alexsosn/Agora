{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexsosn/Agora/registry/schema/materializers.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/plugin"}
    }
  },
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "repository",
        "ref",
        "version",
        "manifest",
        "package",
        "materializers",
        "disciplines",
        "licenses",
        "verification"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "version": {"type": "string", "minLength": 1},
        "manifest": {"$ref": "#/$defs/safeRelativePath"},
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "install_trust"],
          "properties": {
            "type": {"const": "python-project"},
            "path": {"$ref": "#/$defs/safeRelativePath"},
            "install_trust": {"const": "explicit-code-execution"}
          }
        },
        "materializers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        },
        "disciplines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "licenses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["software", "data"],
          "properties": {
            "software": {"type": "string", "minLength": 1},
            "data": {"type": "string", "minLength": 1}
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"enum": ["experimental", "community", "verified"]},
            "notes": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
