{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexsosn/Agora/registry/schema/plugins.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "disciplines", "runtime", "capabilities", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "disciplines": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "upstream": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repository": {"type": "string"},
              "homepage": {"type": "string", "format": "uri"},
              "endpoint": {"type": "string", "format": "uri"}
            },
            "minProperties": 1
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": {"type": "string"},
              "type": {"type": "string"},
              "notes": {"type": "string"}
            }
          },
          "data_mode": {"type": "string"},
          "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "licenses": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "software": {"type": "string"},
              "data": {"type": "string"},
              "service_terms": {"type": "string"}
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {"type": "string"},
              "notes": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
