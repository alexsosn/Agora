{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexsosn/Agora/registry/schema/plugins.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "disciplines", "runtime", "capabilities", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "disciplines": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "upstream": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repository": {"type": "string"},
              "homepage": {"type": "string", "format": "uri"},
              "endpoint": {"type": "string", "format": "uri"}
            },
            "minProperties": 1
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "launch"],
            "properties": {
              "mode": {"type": "string"},
              "type": {"type": "string"},
              "notes": {"type": "string"},
              "launch": {
                "type": "object",
                "additionalProperties": false,
                "required": ["claude", "codex"],
                "properties": {
                  "claude": {"$ref": "#/$defs/launch"},
                  "codex": {"$ref": "#/$defs/launch"}
                }
              }
            }
          },
          "data_mode": {"type": "string"},
          "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "licenses": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "software": {"type": "string"},
              "data": {"type": "string"},
              "service_terms": {"type": "string"}
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "clients"],
            "properties": {
              "status": {"type": "string"},
              "notes": {"type": "array", "items": {"type": "string"}},
              "clients": {
                "type": "object",
                "additionalProperties": false,
                "required": ["claude", "codex"],
                "properties": {
                  "claude": {"$ref": "#/$defs/evidence"},
                  "codex": {"$ref": "#/$defs/evidence"}
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "type": {"type": "string"},
        "command": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "env": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "anyOf": [
        {"required": ["command"]},
        {"required": ["url"]}
      ]
    },
    "sourceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "verificationInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "runtime", "resolution"],
      "properties": {
        "source": {"$ref": "#/$defs/sourceInput"},
        "runtime": {"type": "string", "minLength": 1},
        "resolution": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "checkReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "inputs"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"},
        "inputs": {"$ref": "#/$defs/verificationInputs"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "transport", "checks"],
      "properties": {
        "status": {"type": "string"},
        "transport": {"type": "string", "minLength": 1},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/checkReference"}
        }
      }
    }
  }
}
