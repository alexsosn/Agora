{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexsosn/Agora/registry/schema/verification-checks.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
    },
    "resourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": {"enum": ["linux", "macos", "windows"]},
        "arch": {"enum": ["x86_64", "arm64"]}
      }
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "resource_id"],
          "properties": {
            "type": {"const": "resource"},
            "resource_id": {"$ref": "#/$defs/resourceId"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "resource_id", "member_id"],
          "properties": {
            "type": {"const": "collection-member"},
            "resource_id": {"$ref": "#/$defs/resourceId"},
            "member_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "discovery",
          "materialization",
          "load",
          "representative-content",
          "known-issue-canary"
        ]
      }
    },
    "check": {
      "oneOf": [
        {"$ref": "#/$defs/clientCheck"},
        {"$ref": "#/$defs/resourceCheck"}
      ]
    },
    "clientCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "plugin", "client", "transport", "evidence_level", "executor"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["deterministic", "live"]},
        "plugin": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "client": {"enum": ["claude", "codex"]},
        "transport": {"type": "string", "minLength": 1},
        "evidence_level": {"enum": ["community", "verified"]},
        "platform": {"$ref": "#/$defs/platform"},
        "executor": {
          "oneOf": [
            {"$ref": "#/$defs/unittestExecutor"},
            {"$ref": "#/$defs/actionsExecutor"}
          ]
        }
      }
    },
    "resourceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "plugin", "provider", "evidence_level", "subject", "claims", "executor"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["deterministic", "live"]},
        "plugin": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "evidence_level": {"enum": ["community", "verified"]},
        "subject": {"$ref": "#/$defs/subject"},
        "claims": {"$ref": "#/$defs/claims"},
        "executor": {
          "oneOf": [
            {"$ref": "#/$defs/unittestExecutor"},
            {"$ref": "#/$defs/actionsExecutor"}
          ]
        }
      }
    },
    "unittestExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": {"const": "unittest"},
        "target": {"type": "string", "minLength": 1}
      }
    },
    "actionsExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "workflow", "job", "matrix", "artifact"],
      "properties": {
        "type": {"const": "github-actions"},
        "workflow": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$"},
        "job": {"type": "string", "minLength": 1},
        "matrix": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": ["string", "number", "boolean"]}
        },
        "artifact": {"type": "string", "minLength": 1}
      }
    }
  }
}
