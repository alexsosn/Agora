{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexsosn/Agora/registry/schema/materializer-plugin.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin", "materializers"],
  "properties": {
    "schema_version": {"const": 1},
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"}
      }
    },
    "materializers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/materializer"}
    }
  },
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "executionArgument": {
      "type": "string",
      "pattern": "^(?:[^{}]|\\{(?:source|output|source_revision)\\})*$"
    },
    "materializer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "acquisition", "input", "execution", "output"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "description": {"type": "string", "minLength": 1},
        "acquisition": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/gitAcquisition"},
              {"$ref": "#/$defs/userLocalAcquisition"}
            ]
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "required_globs", "allow_symlinks"],
          "properties": {
            "type": {"const": "directory"},
            "required_globs": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/safeRelativePath"}
            },
            "allow_symlinks": {"type": "boolean"}
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "module", "args", "network"],
          "properties": {
            "type": {"const": "python-module"},
            "module": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
            },
            "args": {
              "type": "array",
              "items": {"$ref": "#/$defs/executionArgument"}
            },
            "network": {"const": "deny"}
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "required_paths"],
          "properties": {
            "format": {"type": "string", "minLength": 1},
            "required_paths": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/safeRelativePath"}
            }
          }
        }
      }
    },
    "gitAcquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "ref", "subpath"],
      "properties": {
        "type": {"const": "git"},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^@]+$"
        },
        "ref": {"type": "string", "minLength": 1, "pattern": "^[^-].*$"},
        "subpath": {"$ref": "#/$defs/safeRelativePath"}
      }
    },
    "userLocalAcquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path_type", "prompt"],
      "properties": {
        "type": {"const": "user-local"},
        "path_type": {"const": "directory"},
        "prompt": {"type": "string", "minLength": 1}
      }
    }
  }
}
