{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexsosn/Agora/registry/schema/resources.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resources"],
  "properties": {
    "schema_version": {"const": 1},
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "plugin", "provider", "kind", "languages", "disciplines", "description", "upstream", "acquisition", "licenses", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "source_id": {"type": "string"},
          "name": {"type": "string", "minLength": 1},
          "plugin": {"type": "string"},
          "provider": {"type": "string"},
          "kind": {"type": "string"},
          "parent": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["parent_versions"],
            "properties": {
              "parent_versions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "module": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {"type": "string"},
              "coverage": {"type": "string", "minLength": 1}
            }
          },
          "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "disciplines": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "period": {"type": "string"},
          "description": {"type": "string", "minLength": 1},
          "upstream": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository"],
            "properties": {
              "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
              "ref": {"type": "string"},
              "tf_path": {"type": "string"},
              "module": {"type": "string", "minLength": 1},
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["repository", "role"],
                  "properties": {
                    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
                    "ref": {"type": "string"},
                    "role": {"type": "string", "minLength": 1},
                    "notes": {"type": "string"}
                  }
                }
              }
            }
          },
          "acquisition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strategy"],
            "properties": {
              "strategy": {"type": "string"},
              "lazy": {"type": "boolean"},
              "notes": {"type": "string"}
            }
          },
          "collection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["discovery", "member_id_scheme", "lazy_members"],
            "properties": {
              "discovery": {"type": "string"},
              "member_id_scheme": {"type": "string"},
              "lazy_members": {"type": "boolean"},
              "member_index": {"type": "string"},
              "notes": {"type": "string"}
            }
          },
          "licenses": {
            "type": "object",
            "additionalProperties": false,
            "required": ["data"],
            "properties": {
              "data": {"type": "string"},
              "redistribution": {"type": "string"},
              "notes": {"type": "string"}
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {"type": "string"},
              "notes": {"type": "array", "items": {"type": "string"}},
              "known_issues": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "severity", "signature", "summary"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
                    },
                    "severity": {"enum": ["advisory", "blocking"]},
                    "signature": {"type": "string", "minLength": 1},
                    "summary": {"type": "string", "minLength": 1},
                    "upstream": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["repository"],
                        "properties": {
                          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
                          "issue": {"type": "integer", "minimum": 1},
                          "url": {"type": "string", "format": "uri"}
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "integration_issues": {"type": "array", "items": {"type": "string"}},
          "source_snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "checked_at"],
            "properties": {
              "source": {"type": "string"},
              "checked_at": {"type": "string", "format": "date"}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "collection"}}},
            "then": {"required": ["collection"]},
            "else": {"not": {"required": ["collection"]}}
          },
          {
            "if": {"properties": {"kind": {"const": "feature-module"}}},
            "then": {"required": ["parent", "compatibility", "module"]},
            "else": {
              "allOf": [
                {"not": {"required": ["parent"]}},
                {"not": {"required": ["compatibility"]}},
                {"not": {"required": ["module"]}}
              ]
            }
          }
        ]
      }
    }
  }
}
