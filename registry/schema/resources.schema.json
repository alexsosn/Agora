{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexsosn/Agora/registry/schema/resources.schema.json",
  "$defs": {
    "loadCostMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_at", "agora_revision", "environment", "evidence"],
      "properties": {
        "checked_at": {"type": "string", "format": "date"},
        "agora_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "environment": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "format": "uri", "pattern": "^https?://\\S+$"}
      }
    },
    "nonNegativeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0}
      }
    },
    "resourceLoadCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "measurement"],
      "properties": {
        "scope": {"const": "resource"},
        "source_size_mb": {"type": "number", "minimum": 0},
        "compiled_size_mb": {"type": "number", "minimum": 0},
        "total_cache_mb": {"type": "number", "minimum": 0},
        "peak_rss_mb": {"type": "number", "minimum": 0},
        "first_load_seconds": {"type": "number", "minimum": 0},
        "warm_load_seconds": {"type": "number", "minimum": 0},
        "measurement": {"$ref": "#/$defs/loadCostMeasurement"},
        "notes": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"required": ["source_size_mb"]},
        {"required": ["compiled_size_mb"]},
        {"required": ["total_cache_mb"]},
        {"required": ["peak_rss_mb"]},
        {"required": ["first_load_seconds"]},
        {"required": ["warm_load_seconds"]}
      ]
    },
    "collectionMemberLoadCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "measurement"],
      "properties": {
        "scope": {"const": "collection-member"},
        "typical_member_cache_mb": {"type": "number", "minimum": 0},
        "typical_member_first_load_seconds": {"$ref": "#/$defs/nonNegativeRange"},
        "discovery_seconds": {"type": "number", "minimum": 0},
        "discovery_cache_mb": {"type": "number", "minimum": 0},
        "measurement": {"$ref": "#/$defs/loadCostMeasurement"},
        "notes": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"required": ["typical_member_cache_mb"]},
        {"required": ["typical_member_first_load_seconds"]},
        {"required": ["discovery_seconds"]},
        {"required": ["discovery_cache_mb"]}
      ]
    },
    "loadCost": {
      "if": {
        "properties": {"scope": {"const": "resource"}},
        "required": ["scope"]
      },
      "then": {"$ref": "#/$defs/resourceLoadCost"},
      "else": {"$ref": "#/$defs/collectionMemberLoadCost"}
    },
    "versionDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["github-releases", "tf-directories", "default-branch", "disabled"]},
        "channel": {"enum": ["stable"]},
        "tag_pattern": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "github-releases"}}, "required": ["mode"]},
          "then": {"required": ["channel"]}
        },
        {
          "if": {"properties": {"mode": {"enum": ["tf-directories", "default-branch", "disabled"]}}, "required": ["mode"]},
          "then": {
            "allOf": [
              {"not": {"required": ["channel"]}},
              {"not": {"required": ["tag_pattern"]}}
            ]
          }
        }
      ]
    },
    "versionDataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "ordering"],
      "properties": {
        "mode": {"enum": ["release-version-match", "captured-version", "latest-root", "fixed", "member-index"]},
        "root": {"type": "string", "minLength": 1},
        "ordering": {"enum": ["semver", "natural", "none"]}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"enum": ["release-version-match", "captured-version", "latest-root", "fixed"]}}, "required": ["mode"]},
          "then": {"required": ["root"]}
        },
        {
          "if": {"properties": {"mode": {"const": "member-index"}}, "required": ["mode"]},
          "then": {"not": {"required": ["root"]}}
        }
      ]
    },
    "versionPromotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["proposal", "discovery-only", "pinned"]}
      }
    },
    "versionAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_version", "signal", "source_revision"],
      "properties": {
        "publication_version": {"type": "string", "minLength": 1},
        "signal": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tf_path": {"type": "string", "minLength": 1}
      }
    },
    "versionTracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery", "dataset", "promotion"],
      "properties": {
        "discovery": {"$ref": "#/$defs/versionDiscovery"},
        "dataset": {"$ref": "#/$defs/versionDataset"},
        "promotion": {"$ref": "#/$defs/versionPromotion"},
        "accepted": {"$ref": "#/$defs/versionAccepted"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resources"],
  "properties": {
    "schema_version": {"const": 1},
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "plugin", "provider", "kind", "languages", "disciplines", "description", "upstream", "acquisition", "licenses", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "source_id": {"type": "string"},
          "name": {"type": "string", "minLength": 1},
          "plugin": {"type": "string"},
          "provider": {"type": "string"},
          "kind": {"type": "string"},
          "parent": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["parent_versions"],
            "properties": {
              "parent_versions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "module": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {"type": "string"},
              "coverage": {"type": "string", "minLength": 1}
            }
          },
          "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "disciplines": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "period": {"type": "string"},
          "description": {"type": "string", "minLength": 1},
          "load_cost": {"$ref": "#/$defs/loadCost"},
          "version_tracking": {"$ref": "#/$defs/versionTracking"},
          "upstream": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository"],
            "properties": {
              "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
              "ref": {"type": "string"},
              "tf_path": {"type": "string"},
              "module": {"type": "string", "minLength": 1},
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["repository", "role"],
                  "properties": {
                    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
                    "ref": {"type": "string"},
                    "role": {"type": "string", "minLength": 1},
                    "notes": {"type": "string"}
                  }
                }
              }
            }
          },
          "acquisition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strategy"],
            "properties": {
              "strategy": {"type": "string"},
              "lazy": {"type": "boolean"},
              "notes": {"type": "string"}
            }
          },
          "collection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["discovery", "member_id_scheme", "lazy_members"],
            "properties": {
              "discovery": {"type": "string"},
              "member_id_scheme": {"type": "string"},
              "lazy_members": {"type": "boolean"},
              "member_index": {"type": "string"},
              "notes": {"type": "string"}
            }
          },
          "licenses": {
            "type": "object",
            "additionalProperties": false,
            "required": ["data"],
            "properties": {
              "data": {"type": "string"},
              "redistribution": {"type": "string"},
              "notes": {"type": "string"},
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "checked_at", "sources"],
                "properties": {
                  "status": {"type": "string"},
                  "checked_at": {"type": "string", "format": "date"},
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "format": "uri", "pattern": "^https?://\\S+$"}
                  }
                }
              }
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {"type": "string"},
              "notes": {"type": "array", "items": {"type": "string"}},
              "evidence": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["check_id"],
                  "properties": {
                    "check_id": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"}
                  }
                }
              },
              "known_issues": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "severity", "impact", "signature", "summary"],
                  "properties": {
                    "id": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"},
                    "severity": {"enum": ["advisory", "blocking"]},
                    "impact": {"enum": ["resource", "member"]},
                    "signature": {"type": "string", "minLength": 1},
                    "summary": {"type": "string", "minLength": 1},
                    "upstream": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["repository"],
                        "properties": {
                          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
                          "issue": {"type": "integer", "minimum": 1},
                          "url": {"type": "string", "format": "uri"}
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "integration_issues": {"type": "array", "items": {"type": "string"}},
          "source_snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "checked_at"],
            "properties": {
              "source": {"type": "string"},
              "checked_at": {"type": "string", "format": "date"}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "collection"}}},
            "then": {"required": ["collection"]},
            "else": {"not": {"required": ["collection"]}}
          },
          {
            "if": {"properties": {"kind": {"const": "feature-module"}}},
            "then": {
              "allOf": [
                {"required": ["parent", "compatibility", "module"]},
                {"not": {"required": ["load_cost"]}},
                {"not": {"required": ["version_tracking"]}}
              ]
            },
            "else": {
              "allOf": [
                {"not": {"required": ["parent"]}},
                {"not": {"required": ["compatibility"]}},
                {"not": {"required": ["module"]}}
              ]
            }
          },
          {
            "if": {"properties": {"kind": {"enum": ["corpus", "collection"]}}},
            "then": {"properties": {"licenses": {"required": ["redistribution", "evidence"]}}}
          }
        ]
      }
    }
  }
}
